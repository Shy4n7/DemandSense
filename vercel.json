{
  "version": 2,
  "builds": [
    {
      "src": "api/products.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": ["data/clean.json", "lib/**"]
      }
    },
    {
      "src": "api/forecast.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": ["data/clean.json", "lib/**", "models/**"]
      }
    },
    {
      "src": "api/anomalies.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": ["data/clean.json", "lib/**", "models/**"]
      }
    },
    {
      "src": "api/importance.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": ["data/clean.json", "lib/**", "models/**"]
      }
    },
    {
      "src": "api/inventory.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": ["data/clean.json", "lib/**", "models/**"]
      }
    },
    {
      "src": "api/simulation.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": ["data/clean.json", "lib/**"]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/build/index.html"
    }
  ]
}
